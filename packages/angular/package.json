{
  "name": "@oozkul/dental-3d-angular",
  "version": "0.0.0",
  "description": "Angular standalone component <dental-3d>: an interactive 3D dental chart (odontogram) with signal inputs and outputs, wrapping @oozkul/dental-3d.",
  "license": "MIT",
  "keywords": [
    "angular",
    "ngx",
    "ngx-dental-viewer",
    "dental",
    "dental-chart",
    "odontogram",
    "teeth",
    "3d",
    "three.js",
    "fdi",
    "dental-3d"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClickFlick/odontogram.git",
    "directory": "packages/angular"
  },
  "homepage": "https://clickflick.github.io/odontogram/",
  "bugs": "https://github.com/ClickFlick/odontogram/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && ng-packagr -p ng-package.json -c tsconfig.lib.json && node scripts/postbuild.mjs"
  },
  "peerDependencies": {
    "@angular/core": ">=21.0.0",
    "@oozkul/dental-3d": "^0.1.0",
    "three": ">=0.160.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/compiler": "^21.2.24",
    "@angular/compiler-cli": "^21.2.24",
    "@angular/core": "^21.2.24",
    "ng-packagr": "^21.2.0",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2"
  }
}
