{
  "name": "@oozkul/dental-3d",
  "version": "0.1.0",
  "description": "Interactive 3D dental chart (odontogram) for the web: clickable teeth, FDI numbering, per-tooth status, framework-free, built on three.js.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./model/default.glb": "./model/default.glb",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "model/default.glb",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dental",
    "dental-chart",
    "odontogram",
    "teeth",
    "tooth",
    "3d",
    "three.js",
    "threejs",
    "fdi",
    "ngx-dental-viewer",
    "dental-3d",
    "clinic",
    "ehr"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClickFlick/odontogram.git",
    "directory": "packages/core"
  },
  "homepage": "https://clickflick.github.io/odontogram/",
  "bugs": "https://github.com/ClickFlick/odontogram/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "model:generate": "tsx model/generate.ts",
    "model:embed": "tsx scripts/embed-model.ts",
    "prebuild": "npm run model:embed",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "pretest": "npm run model:embed",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "size": "npm run build && node scripts/size.mjs"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@vitest/browser-playwright": "^5.0.2",
    "gltfpack": "^1.3.0",
    "playwright": "^1.63.0",
    "rimraf": "^6.0.1",
    "three": "^0.186.1",
    "tsx": "^4.20.0",
    "vitest": "^5.0.2"
  }
}
